DATABASE_URL=
# At least 32 random characters; required in production for signed cookies.
SESSION_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Hostname checked against Cloudflare Turnstile siteverify responses; defaults to the request host.
PORTAL_HOSTNAME=
PROXYCHECK_API_KEY=
# Local development only: localhost has no forwarded public IP header.
# Never enable this in production.
ALLOW_LOCALHOST_NETWORK_CHECK=false
# Trust only this proxy's client-IP header. Use vercel on Vercel deployments.
TRUSTED_PROXY_MODE=none
# Local development/test only; production uses the shared Neon limiter.
RATE_LIMIT_BACKEND=neon
# Required only for Vercel Cron requests to /api/bot/outbox.
CRON_SECRET=
TOKEN_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=365
OUTBOX_RETENTION_DAYS=30
# Key used to authenticate bot requests to this portal.
BOT_TO_PORTAL_KEY=
# Key used by this portal to authenticate callbacks to the bot.
PORTAL_TO_BOT_KEY=
# Deprecated one-release fallback for both directions; rotate to separate keys.
AXEX_BOT_API_KEY=
# Internal bot receiver URL; never expose this value to browser code.
BOT_WEBHOOK_URL=
# Server-only account intelligence API; never use a VITE_ prefix.
INTELLIGENCE_URL=
INTELLIGENCE_API_KEY=
