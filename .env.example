DATABASE_URL=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
PROXYCHECK_API_KEY=
# Local development only: localhost has no forwarded public IP header.
# Never enable this in production.
ALLOW_LOCALHOST_NETWORK_CHECK=false
# Must exactly match WEBSITE_API_KEY or AXEX_BOT_API_KEY in the bot .env.
AXEX_BOT_API_KEY=
# Internal bot receiver URL; never expose this value to browser code.
BOT_WEBHOOK_URL=https://your-bot-host.example.com/verify-callback
