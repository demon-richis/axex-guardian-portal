{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "dist/server/**"
    }
  },
  "crons": [
    {
      "path": "/api/bot/outbox",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?__axex_path=/api/:path*" },
    { "source": "/:path*", "destination": "/api?__axex_path=/:path*" }
  ]
}
