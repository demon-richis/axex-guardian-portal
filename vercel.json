{
  "version": 2,
  "buildCommand": "npm run build && rm -rf api/dist-server && cp -R dist/server api/dist-server",
  "outputDirectory": "dist/client",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "api/dist-server/**"
    }
  },
  "crons": [
    {
      "path": "/api/bot/outbox",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?__axex_path=/api/:path*" },
    { "source": "/", "destination": "/api?__axex_path=/" },
    { "source": "/:path*", "destination": "/api?__axex_path=/:path*" }
  ]
}
